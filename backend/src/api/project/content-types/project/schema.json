        "En autorisation",
        "En développement",
        "En travaux",
        "En commercialisation",
        "Livré",
        "Commercialisé 100%"
      ]
    },
    "type_operation": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
