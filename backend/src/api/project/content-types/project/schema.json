      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "statut": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "À venir",
        "Entièrement commercialisé",
        "En cours d’autorisation",
        "En cours de commercialisation",
        "Livré"
      ]
    },
    "type_operation": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
