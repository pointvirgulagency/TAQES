{
  "kind": "collectionType",
  "collectionName": "demandes",
  "info": {
    "singularName": "demande",
    "pluralName": "demandes",
    "displayName": "Demande"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom_complet": {
      "type": "string"
    },
    "telephone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "preference_contact": {
      "type": "enumeration",
      "enum": [
        "Email",
        "Téléphone",
        "WhatsApp"
      ]
    },
    "langue": {
      "type": "enumeration",
      "enum": [
        "Français",
        "العربية"
      ]
    },
    "ville": {
      "type": "string"
    },
    "message": {
      "type": "blocks"
    },
    "consentement": {
      "type": "boolean"
    },
    "demande_detail": {
      "type": "dynamiczone",
      "components": [
        "shared.demande-projet",
        "shared.demande-partenariat",
        "shared.demande-foncier",
        "shared.demande-reclamation-field"
      ]
    }
  }
}
